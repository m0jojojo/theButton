# Copy to .env for local development, or paste these keys into your host's
# environment variable settings (Vercel: Project > Settings > Environment Variables).

# --- Required ---

# PostgreSQL connection string.
# Local:  postgresql://postgres:PASSWORD@localhost:5432/thebutton?schema=public
# Hosted: copy from Neon / Supabase (include ?sslmode=require if they give it)
DATABASE_URL=""

# Secret used to sign auth tokens. Generate a fresh random value per
# environment - never reuse the development one in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Public base URL, no trailing slash. Used for canonical URLs and OG tags.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- Optional ---

# Creates a default admin on first boot in development.
INIT_ADMIN="false"
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_PASSWORD=""
DEFAULT_CUSTOMER_EMAIL=""
DEFAULT_CUSTOMER_PASSWORD=""

# Analytics and payments - leave blank to disable.
NEXT_PUBLIC_GA=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
